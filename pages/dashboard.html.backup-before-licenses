<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Dashboard – JCF Connect | Joy Christian Fellowship – Rongai</title>
  <link rel="icon" type="image/jpeg" href="../assets/images/logo.jpg" />
  <link rel="apple-touch-icon" href="../assets/images/logo.jpg" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    :root, [data-theme="dark"] {
      --accent: #c41e3a; --gold: #d4a017; --bg: #080f18; --sidebar: #0c1524;
      --card: #111c2e; --text: #f1f5f9; --text-muted: #94a3b8; --border: #1e3352;
      --success: #10b981; --info: #3b82f6;
    }
    [data-theme="light"] {
      --bg: #f1f5f9; --sidebar: #ffffff; --card: #ffffff; --text: #0f172a;
      --text-muted: #64748b; --border: #e2e8f0;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--bg); color: var(--text); min-height: 100vh;
      display: flex; transition: background 0.25s, color 0.25s;
    }
    .sidebar {
      width: 260px; background: var(--sidebar); border-right: 1px solid var(--border);
      display: flex; flex-direction: column; position: fixed; top: 0; left: 0; bottom: 0;
      z-index: 100; transition: transform 0.3s ease;
    }
    .sidebar-header {
      padding: 1.25rem 1.1rem; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 0.75rem;
    }
    .sidebar-logo {
      width: 42px; height: 42px; object-fit: contain; border-radius: 50%;
      background: rgba(196,30,58,0.15); padding: 4px;
    }
    .sidebar-brand h1 { font-size: 0.85rem; font-weight: 700; line-height: 1.25; }
    .sidebar-brand span {
      font-size: 0.62rem; color: var(--gold); letter-spacing: 0.06em;
      text-transform: uppercase; font-weight: 600;
    }
    .sidebar-nav { flex: 1; padding: 0.75rem; overflow-y: auto; -webkit-overflow-scrolling: touch; }
    .nav-item {
      display: flex; align-items: center; gap: 0.7rem;
      padding: 0.72rem 0.85rem; border-radius: 10px; color: var(--text-muted);
      text-decoration: none; font-size: 0.9rem; margin-bottom: 0.2rem; min-height: 44px;
    }
    .nav-item:hover { background: rgba(196,30,58,0.08); color: var(--text); }
    .nav-item.active {
      background: linear-gradient(135deg, rgba(196,30,58,0.2), rgba(196,30,58,0.08));
      color: #ff6b7a; border: 1px solid rgba(196,30,58,0.25);
    }
    .nav-icon { width: 1.35rem; text-align: center; flex-shrink: 0; }
    .sidebar-footer {
      padding: 1rem; border-top: 1px solid var(--border);
      font-size: 0.68rem; color: var(--text-muted); text-align: center; line-height: 1.5;
    }
    .sidebar-overlay {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 90;
    }
    .sidebar-overlay.show { display: block; }
    .main { flex: 1; margin-left: 260px; min-height: 100vh; display: flex; flex-direction: column; min-width: 0; }
    .topbar {
      background: var(--card); border-bottom: 1px solid var(--border);
      padding: 0.85rem 1.25rem; display: flex; align-items: center;
      justify-content: space-between; gap: 0.75rem; position: sticky; top: 0; z-index: 50; flex-wrap: wrap;
    }
    .topbar-left { display: flex; align-items: center; gap: 0.75rem; min-width: 0; }
    .menu-toggle {
      display: none; background: none; border: none; color: var(--text);
      font-size: 1.45rem; cursor: pointer; min-width: 44px; min-height: 44px;
      align-items: center; justify-content: center;
    }
    .topbar-left h2 { font-size: 1.1rem; font-weight: 600; }
    .topbar-left p { font-size: 0.78rem; color: var(--text-muted); margin-top: 0.15rem; }
    .topbar-right { display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0; flex-wrap: wrap; }
    .date-badge {
      font-size: 0.8rem; color: var(--text-muted); background: rgba(128,128,128,0.08);
      padding: 0.4rem 0.8rem; border-radius: 8px; border: 1px solid var(--border);
    }
    .session-timer {
      font-size: 0.75rem; color: var(--text-muted); background: rgba(196,30,58,0.1);
      border: 1px solid rgba(196,30,58,0.25); padding: 0.35rem 0.7rem;
      border-radius: 8px; font-weight: 500;
    }
    .session-timer.warn { color: #fbbf24; border-color: rgba(251,191,36,0.4); background: rgba(251,191,36,0.1); }
    .icon-btn {
      width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--border);
      background: transparent; color: var(--text-muted); cursor: pointer;
      display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
    }
    .icon-btn:hover { border-color: var(--accent); color: var(--text); background: rgba(196,30,58,0.08); }
    .user-info { display: flex; align-items: center; gap: 0.6rem; }
    .user-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), #9b1b2e);
      display: flex; align-items: center; justify-content: center;
      font-weight: 600; font-size: 0.85rem; color: #fff;
    }
    .user-name { font-size: 0.875rem; font-weight: 500; }
    .user-role { font-size: 0.7rem; color: var(--text-muted); }
    .content { padding: 1.25rem; flex: 1; }
    .welcome-banner {
      background: linear-gradient(135deg, rgba(196,30,58,0.15), rgba(196,30,58,0.05));
      border: 1px solid rgba(196,30,58,0.25); border-radius: 14px;
      padding: 1.15rem 1.35rem; margin-bottom: 1.25rem;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;
    }
    .welcome-banner h3 { font-size: 1.1rem; font-weight: 600; }
    .welcome-banner p { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem; }
    .stats-grid {
      display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.85rem; margin-bottom: 1.25rem;
    }
    .stat-card {
      background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 1.1rem;
    }
    .stat-label { font-size: 0.75rem; color: var(--text-muted); font-weight: 500; margin-bottom: 0.45rem; }
    .stat-value { font-size: 1.5rem; font-weight: 700; line-height: 1; }
    .stat-change { font-size: 0.7rem; margin-top: 0.4rem; color: var(--success); }
    .stat-card.green .stat-value { color: #34d399; }
    .stat-card.blue .stat-value { color: #60a5fa; }
    .stat-card.gold .stat-value { color: var(--gold); }
    .stat-card.purple .stat-value { color: #a78bfa; }
    .middle-row {
      display: grid; grid-template-columns: 1fr 1fr minmax(260px, 320px); gap: 1rem; margin-bottom: 1.25rem;
    }
    .card {
      background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 1.2rem;
    }
    .card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; gap: 0.5rem; }
    .card-title { font-size: 0.95rem; font-weight: 600; }
    .card-subtitle { font-size: 0.75rem; color: var(--text-muted); }
    .chart-wrap { position: relative; height: 220px; }
    .mini-stat { display: flex; justify-content: space-between; padding: 0.5rem 0; font-size: 0.85rem; }
    .mini-stat .label { color: var(--text-muted); }
    .mini-stat .val { font-weight: 600; }
    .mini-stat .val.green { color: #34d399; }
    .mini-stat .val.red { color: #ff6b7a; }
    .mini-stat .val.gold { color: var(--gold); }
    .activity-list { list-style: none; max-height: 280px; overflow-y: auto; }
    .activity-item {
      display: flex; gap: 0.75rem; padding: 0.7rem 0; border-bottom: 1px solid var(--border);
    }
    .activity-item:last-child { border-bottom: none; }
    .activity-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 6px; flex-shrink: 0; }
    .activity-dot.red { background: var(--accent); }
    .activity-dot.green { background: var(--success); }
    .activity-dot.blue { background: var(--info); }
    .activity-dot.gold { background: var(--gold); }
    .activity-text { font-size: 0.82rem; line-height: 1.4; }
    .activity-time { font-size: 0.7rem; color: var(--text-muted); margin-top: 0.2rem; }
    .quick-actions { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.75rem; }
    .action-btn {
      background: var(--card); border: 1px solid var(--border); border-radius: 12px;
      padding: 1rem 0.65rem; text-align: center; text-decoration: none; color: var(--text);
      transition: all 0.15s; min-height: 88px; display: flex; flex-direction: column;
      align-items: center; justify-content: center;
    }
    .action-btn:hover {
      border-color: var(--accent); background: rgba(196,30,58,0.08); transform: translateY(-2px);
    }
    .action-icon { font-size: 1.35rem; margin-bottom: 0.35rem; }
    .action-label { font-size: 0.78rem; font-weight: 500; }
    .session-warning {
      position: fixed; bottom: 1.25rem; right: 1.25rem; left: 1.25rem; max-width: 340px; margin-left: auto;
      background: var(--card); border: 1px solid var(--accent); border-radius: 12px;
      padding: 1.15rem 1.35rem; box-shadow: 0 8px 30px rgba(0,0,0,0.35); z-index: 200; display: none;
    }
    .session-warning.show { display: block; }
    .session-warning h4 { font-size: 0.95rem; margin-bottom: 0.4rem; color: #ff6b7a; }
    .session-warning p { font-size: 0.85rem; margin-bottom: 0.9rem; color: var(--text-muted); line-height: 1.45; }
    .session-warning .btn-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .session-warning button {
      border: none; padding: 0.55rem 1rem; border-radius: 8px; font-size: 0.8rem;
      font-weight: 600; cursor: pointer; font-family: inherit; min-height: 40px;
    }
    .session-warning .btn-stay { background: var(--accent); color: #fff; }
    .session-warning .btn-logout {
      background: transparent; border: 1px solid var(--border); color: var(--text-muted);
    }
    @media (max-width: 1200px) {
      .stats-grid { grid-template-columns: repeat(3, 1fr); }
      .middle-row { grid-template-columns: 1fr 1fr; }
      .middle-row .card:last-child { grid-column: 1 / -1; }
      .quick-actions { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 900px) {
      .sidebar { transform: translateX(-100%); width: min(280px, 85vw); }
      .sidebar.open { transform: translateX(0); box-shadow: 8px 0 30px rgba(0,0,0,0.35); }
      .main { margin-left: 0; }
      .menu-toggle { display: flex; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .topbar-left p { display: none; }
      .user-info > div:last-child { display: none; }
    }
    @media (max-width: 560px) {
      .stats-grid { grid-template-columns: 1fr; }
      .middle-row { grid-template-columns: 1fr; }
      .quick-actions { grid-template-columns: repeat(2, 1fr); }
      .content { padding: 0.9rem; }
      .topbar-right .date-badge { display: none; }
    }
    .global-search { position: relative; flex: 1; min-width: 180px; max-width: 360px; }
    .global-search > span { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 1.25rem; pointer-events: none; }
    .global-search input { width: 100%; padding: 0.7rem 0.9rem 0.7rem 2.2rem; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); color: var(--text); outline: none; }
    .global-search input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(196, 30, 58, 0.12); }
    .global-search-results { position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 150; max-height: 300px; overflow-y: auto; padding: 6px; background: var(--card); border: 1px solid var(--border); border-radius: 10px; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2); }
    .global-search-results[hidden] { display: none; }
    .global-search-results a { display: block; padding: 10px; color: var(--text); text-decoration: none; border-radius: 7px; font-size: 0.88rem; }
    .global-search-results a:hover, .global-search-results a:focus { background: rgba(196, 30, 58, 0.12); outline: none; }
    .global-search-results .no-results { padding: 10px; color: var(--text-muted); font-size: 0.85rem; }
    @media (max-width: 560px) { .global-search { order: 3; flex-basis: 100%; max-width: none; } }
  </style>
</head>
