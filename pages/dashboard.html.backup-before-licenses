  <script>
    var API = '/api';
    var attendanceChart = null;
    var financeChart = null;
    var lastAtt = [];
    var lastFin = [];

    function getSession() {
      try { return JSON.parse(localStorage.getItem('jcf_user') || 'null'); }
      catch (e) { return null; }
    }
    function getToken() { return localStorage.getItem('jcf_token') || ''; }
    function logout() {
      localStorage.removeItem('jcf_token');
      localStorage.removeItem('jcf_user');
      window.location.href = 'login.html';
    }
    function requireLogin() {
      var session = getSession();
      var token = getToken();
      if (!session || !token) {
        window.location.href = 'login.html';
        return null;
      }
      return session;
    }
    function apiFetch(path) {
      return fetch(API + path, {
        headers: { Authorization: 'Bearer ' + getToken() }
      }).then(function (res) {
        if (res.status === 401) {
          logout();
          return Promise.reject(new Error('Unauthorized'));
        }
        return res.text().then(function (text) {
          var data = null;
          try { data = text ? JSON.parse(text) : null; }
          catch (e) { return { ok: false, data: null }; }
          return { ok: res.ok, data: data };
        });
      });
    }

    var session = requireLogin();
    if (session) {
      document.getElementById('userName').textContent = session.name || 'User';
      document.getElementById('userRole').textContent = session.role || '';
      document.getElementById('userAvatar').textContent = (session.name || '?').charAt(0).toUpperCase();
      document.getElementById('welcomeText').textContent =
        'Welcome back, ' + (session.name || 'User').split(' ')[0] + '!';
    }

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('jcf_theme', theme);
      var btn = document.getElementById('themeToggle');
      if (btn) btn.textContent = theme === 'dark' ? '☀️' : '🌙';
      if (lastAtt.length || lastFin.length) buildCharts(theme, lastAtt, lastFin);
    }
    function toggleTheme() {
      var current = document.documentElement.getAttribute('data-theme') || 'dark';
      applyTheme(current === 'dark' ? 'light' : 'dark');
    }
    var savedTheme = localStorage.getItem('jcf_theme') || 'dark';
    applyTheme(savedTheme);

    function openSidebar() {
      document.getElementById('sidebar').classList.add('open');
      document.getElementById('sidebarOverlay').classList.add('show');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('sidebarOverlay').classList.remove('show');
      document.body.style.overflow = '';
    }

    /* 5-minute idle logout (this page) – access.js also handles other pages */
    var IDLE_MS = 5 * 60 * 1000;
    var WARN_BEFORE_MS = 60 * 1000;
    var idleTimer = null, warnTimer = null, countdownInterval = null;
    var lastActivity = Date.now();

    function formatTime(ms) {
      var s = Math.max(0, Math.ceil(ms / 1000));
      var m = Math.floor(s / 60);
      var sec = s % 60;
      return m + ':' + (sec < 10 ? '0' : '') + sec;
    }
    function updateTimerDisplay() {
      var remainingMs = IDLE_MS - (Date.now() - lastActivity);
      var el = document.getElementById('sessionTimer');
      if (!el) return;
      el.textContent = '⏱ ' + formatTime(remainingMs);
      if (remainingMs <= WARN_BEFORE_MS) el.classList.add('warn');
      else el.classList.remove('warn');
    }
    function resetIdleTimer() {
      var warn = document.getElementById('sessionWarning');
      if (warn) warn.classList.remove('show');
      clearTimeout(idleTimer);
      clearTimeout(warnTimer);
      clearInterval(countdownInterval);
      lastActivity = Date.now();
      updateTimerDisplay();
      warnTimer = setTimeout(function () {
        document.getElementById('sessionWarning').classList.add('show');
        var secsLeft = 60;
        document.getElementById('warnSeconds').textContent = secsLeft;
        countdownInterval = setInterval(function () {
          secsLeft--;
          document.getElementById('warnSeconds').textContent = Math.max(0, secsLeft);
          if (secsLeft <= 0) clearInterval(countdownInterval);
        }, 1000);
      }, IDLE_MS - WARN_BEFORE_MS);
      idleTimer = setTimeout(function () {
        alert('You have been logged out due to inactivity.');
        logout();
      }, IDLE_MS);
    }
    ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach(function (evt) {
      document.addEventListener(evt, resetIdleTimer, { passive: true });
    });

    var dateStr = new Date().toLocaleDateString('en-GB', {
      weekday: 'short', year: 'numeric', month: 'short', day: 'numeric'
    });
    document.getElementById('currentDate').textContent = dateStr;
    document.getElementById('bannerDate').textContent = dateStr;

    function formatMoney(n) {
      return 'KES ' + Number(n || 0).toLocaleString('en-KE');
    }

    function loadChurchLine() {
      try {
        var church = JSON.parse(localStorage.getItem('jcf_church') || 'null');
        if (church && church.name) {
          var line = church.name;
          if (church.slogan) line += ' · ' + church.slogan;
          document.getElementById('churchLine').textContent = line;
        }
      } catch (e) {}
      apiFetch('/settings').then(function (r) {
        if (!r.ok || !r.data) return;
        var c = r.data.church || r.data;
        if (c && c.name) {
          var line = c.name;
          if (c.slogan) line += ' · ' + c.slogan;
          document.getElementById('churchLine').textContent = line;
          localStorage.setItem('jcf_church', JSON.stringify(c));
        }
      }).catch(function () {});
    }

    function loadFromModules() {
      return Promise.all([
        apiFetch('/members').catch(function () { return { ok: false }; }),
        apiFetch('/visitors').catch(function () { return { ok: false }; }),
        apiFetch('/groups').catch(function () { return { ok: false }; }),
        apiFetch('/attendance').catch(function () { return { ok: false }; }),
        apiFetch('/finance').catch(function () { return { ok: false }; }),
        apiFetch('/users/logs').catch(function () { return { ok: false }; })
      ]).then(function (results) {
        var members = results[0].ok && Array.isArray(results[0].data) ? results[0].data : [];
        var visitors = results[1].ok && Array.isArray(results[1].data) ? results[1].data : [];
        var groups = results[2].ok && Array.isArray(results[2].data) ? results[2].data : [];
        var att = results[3].ok && Array.isArray(results[3].data) ? results[3].data : [];
        var fin = results[4].ok && Array.isArray(results[4].data) ? results[4].data : [];
        var logs = results[5].ok && Array.isArray(results[5].data) ? results[5].data : [];

        document.getElementById('statMembers').textContent = String(members.length);
        document.getElementById('statActive').textContent = String(
          members.filter(function (m) { return m.status === 'Active'; }).length
        );
        document.getElementById('statVisitors').textContent = String(visitors.length);
        document.getElementById('statGroups').textContent = String(
          groups.filter(function (g) { return g.status === 'Active'; }).length || groups.length
        );
        if (att[0]) document.getElementById('statAttendance').textContent = String(att[0].total || 0);

        var income = fin.filter(function (t) { return t.type === 'income'; })
          .reduce(function (s, t) { return s + (Number(t.amount) || 0); }, 0);
        var expense = fin.filter(function (t) { return t.type === 'expense'; })
          .reduce(function (s, t) { return s + (Number(t.amount) || 0); }, 0);
        var tithe = fin.filter(function (t) {
          return t.type === 'income' && String(t.category || '').toLowerCase() === 'tithe';
        }).reduce(function (s, t) { return s + (Number(t.amount) || 0); }, 0);

        document.getElementById('finIncome').textContent = formatMoney(income);
        document.getElementById('finExpense').textContent = formatMoney(expense);
        document.getElementById('finBalance').textContent = formatMoney(income - expense);
        document.getElementById('finTithe').textContent = formatMoney(tithe);

        lastAtt = att;
        lastFin = fin;
        buildCharts(savedTheme, att, fin);
        renderActivity(logs);
      });
    }

    function renderActivity(logs) {
      var list = document.getElementById('activityList');
      if (!logs || !logs.length) {
        list.innerHTML =
          '<li class="activity-item"><div class="activity-dot green"></div><div>' +
          '<div class="activity-text">Logged in successfully</div>' +
          '<div class="activity-time">Just now</div></div></li>';
        return;
      }
      list.innerHTML = logs.slice(0, 8).map(function (log) {
        var action = log.action || log.detail || 'Activity';
        var actor = log.actor || '';
        var when = log.at ? new Date(log.at).toLocaleString('en-GB') : '';
        return '<li class="activity-item">' +
          '<div class="activity-dot blue"></div><div>' +
          '<div class="activity-text">' + action + (actor ? ' · ' + actor : '') + '</div>' +
          '<div class="activity-time">' + when + '</div></div></li>';
      }).join('');
    }

    function getChartColors(theme) {
      var isDark = theme === 'dark';
      return {
        grid: isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)',
        text: isDark ? '#94a3b8' : '#64748b',
        accent: '#c41e3a'
      };
    }

    function buildCharts(theme, att, fin) {
      att = att || [];
      fin = fin || [];
      var c = getChartColors(theme);
      var attLabels = ['No data'];
      var attData = [0];
      if (att.length) {
        var recent = att.slice(0, 6).reverse();
        attLabels = recent.map(function (r) {
          try {
            return new Date(r.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
          } catch (e) { return r.date || ''; }
        });
        attData = recent.map(function (r) { return Number(r.total) || 0; });
      }

      if (attendanceChart) attendanceChart.destroy();
      attendanceChart = new Chart(document.getElementById('attendanceChart'), {
        type: 'line',
        data: {
          labels: attLabels,
          datasets: [{
            label: 'Total Attendance',
            data: attData,
            borderColor: c.accent,
            backgroundColor: 'rgba(196,30,58,0.15)',
            fill: true,
            tension: 0.35,
            pointBackgroundColor: c.accent,
            pointRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { ticks: { color: c.text }, grid: { color: c.grid } },
            y: { ticks: { color: c.text }, grid: { color: c.grid }, beginAtZero: true }
          }
        }
      });

      var income = fin.filter(function (t) { return t.type === 'income'; })
        .reduce(function (s, t) { return s + (Number(t.amount) || 0); }, 0);
      var expense = fin.filter(function (t) { return t.type === 'expense'; })
        .reduce(function (s, t) { return s + (Number(t.amount) || 0); }, 0);

      if (financeChart) financeChart.destroy();
      financeChart = new Chart(document.getElementById('financeChart'), {
        type: 'bar',
        data: {
          labels: ['Income', 'Expenses'],
          datasets: [{
            label: 'KES',
            data: [income, expense],
            backgroundColor: ['rgba(52,211,153,0.7)', 'rgba(196,30,58,0.7)'],
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { ticks: { color: c.text }, grid: { color: c.grid } },
            y: {
              ticks: {
                color: c.text,
                callback: function (v) { return v >= 1000 ? (v / 1000) + 'k' : v; }
              },
              grid: { color: c.grid },
              beginAtZero: true
            }
          }
        }
      });
    }
    function setupGlobalSearch() {
      var input = document.getElementById('globalSearch');
      var results = document.getElementById('globalSearchResults');
      var nav = document.querySelector('.sidebar-nav');
      if (!input || !results || !nav) return;

      var pages = Array.prototype.slice.call(nav.querySelectorAll('a.nav-item')).map(function (link) {
        return { label: link.textContent.replace(/\s+/g, ' ').trim(), href: link.getAttribute('href') };
      }).filter(function (page) { return page.label && page.href; });
      var activeIndex = -1;

      function hideResults() { results.hidden = true; activeIndex = -1; }
      function renderResults() {
        var query = input.value.trim().toLowerCase();
        results.replaceChildren();
        activeIndex = -1;
        if (!query) { hideResults(); return; }
        var matches = pages.filter(function (page) { return page.label.toLowerCase().indexOf(query) !== -1; }).slice(0, 8);
        if (!matches.length) {
          var empty = document.createElement('div');
          empty.className = 'no-results';
          empty.textContent = 'No matching sections found';
          results.appendChild(empty);
        } else {
          matches.forEach(function (page) {
            var link = document.createElement('a');
            link.href = page.href;
            link.textContent = page.label;
            link.addEventListener('click', hideResults);
            results.appendChild(link);
          });
        }
        results.hidden = false;
      }

      input.addEventListener('input', renderResults);
      input.addEventListener('keydown', function (event) {
        var links = results.querySelectorAll('a');
        if (event.key === 'Escape') { hideResults(); input.blur(); return; }
        if (event.key === 'ArrowDown' && links.length) {
          event.preventDefault(); activeIndex = (activeIndex + 1) % links.length;
          Array.prototype.forEach.call(links, function (link, index) { link.style.outline = index === activeIndex ? '2px solid var(--accent)' : ''; });
        } else if (event.key === 'ArrowUp' && links.length) {
          event.preventDefault(); activeIndex = (activeIndex - 1 + links.length) % links.length;
          Array.prototype.forEach.call(links, function (link, index) { link.style.outline = index === activeIndex ? '2px solid var(--accent)' : ''; });
        } else if (event.key === 'Enter' && links.length) {
          event.preventDefault();
          var target = activeIndex >= 0 ? links[activeIndex] : links[0];
          window.location.href = target.href;
        }
      });
      document.addEventListener('click', function (event) {
        if (!event.target.closest('.global-search')) hideResults();
      });
    }
    setupGlobalSearch();

    loadChurchLine();
    loadFromModules();
    resetIdleTimer();
    setInterval(updateTimerDisplay, 1000);
  </script>
  <script src="js/access.js"></script>
</body>
</html>
